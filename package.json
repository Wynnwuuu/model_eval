{
  "name": "manueval",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:offline": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:VITE_STORAGE_MODE='local'; npm.cmd run dev\"",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:prod": "node dist-server/server/db/migrate.js",
    "db:psql": "docker compose exec postgres psql -U eval_studio -d eval_studio",
    "api:dev": "tsx server/index.ts",
    "api:start": "node dist-server/server/index.js",
    "server:build": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "dev:full": "tsx scripts/dev-full.ts",
    "test:generation": "tsx scripts/test-generation.ts && tsx scripts/test-generation-seed.ts && tsx scripts/test-vidmuse-input.ts && node scripts/test-deployment-runtime.mjs",
    "test:generation:db": "tsx scripts/test-generation-db.ts",
    "test:api:smoke": "tsx scripts/smoke-postgres-api.ts",
    "test:arena": "tsx scripts/test-arena.ts",
    "test:dataset-sync": "tsx scripts/test-dataset-sync.ts && tsx scripts/test-dataset-versioned-sync.ts && tsx scripts/test-feishu-base-client.ts && tsx scripts/test-dataset-direct-import.ts",
    "test:dataset-sync:db": "tsx scripts/test-dataset-versioned-sync-db.ts",
    "test:dataset-clone": "tsx scripts/test-dataset-clone.ts",
    "test:dataset-column-deletion": "tsx scripts/test-dataset-column-deletion.ts",
    "test:dataset-import-mappings": "tsx scripts/test-dataset-import-mappings.ts",
    "test:dataset-direct-import": "tsx scripts/test-dataset-direct-import.ts",
    "test:dataset-table-columns": "tsx scripts/test-dataset-table-columns.ts",
    "test:dataset-filters": "tsx scripts/test-dataset-filters.ts",
    "test:task-case-selection": "tsx scripts/test-task-case-selection.ts",
    "test:evaluation-reference-media": "tsx scripts/test-evaluation-reference-media.ts",
    "test:layout-sizing": "tsx scripts/test-layout-sizing.ts",
    "test:structured-evaluation-audit": "tsx scripts/test-preserved-source-import.ts && tsx scripts/test-dataset-compatibility-audit.ts && tsx scripts/test-structured-evaluation-quality.ts",
    "import:feishu-evaluation": "tsx scripts/import-feishu-base-evaluation.ts",
    "publish:structured-evaluation": "tsx scripts/publish-structured-evaluation-datasets.ts",
    "audit:generation-matrix": "tsx scripts/dry-run-generation-dataset.ts --all-models",
    "audit:structured-evaluation": "tsx scripts/audit-structured-evaluation.ts",
    "audit:audio-review-clips": "tsx scripts/create-audio-review-clips.ts",
    "test:rank-ties": "tsx scripts/test-rank-ties.ts",
    "test:model-feedback": "tsx scripts/test-model-feedback.ts",
    "test:insights-summary": "tsx scripts/test-insights-summary.ts",
    "test:insight-exports": "tsx scripts/test-insight-exports.ts",
    "test:insight-workspace": "tsx scripts/test-insight-workspace.ts",
    "test:insight-links": "tsx scripts/test-insight-links.ts",
    "test:task-results": "tsx scripts/test-task-results.ts",
    "test:page-metadata": "tsx scripts/test-page-metadata.ts",
    "test:owner-access": "tsx scripts/test-owner-access.ts",
    "test:owner-access:disabled": "tsx scripts/test-owner-access-disabled.ts",
    "test:owner-access:db": "tsx scripts/test-owner-access-db.ts",
    "test:projects": "tsx scripts/test-project-contract.ts",
    "test:evaluation-storage": "tsx scripts/test-evaluation-client-storage.ts",
    "test:e2e:evaluation-storage": "playwright test e2e/evaluation-storage.spec.ts e2e/arena-rank-playback.spec.ts e2e/overview-material-navigation.spec.ts e2e/evaluation-feedback-reveal.spec.ts e2e/owner-access.spec.ts e2e/task-builder-generated-columns.spec.ts",
    "migrate:postgres": "tsx scripts/migrate-to-postgres.ts",
    "owner-access:generate": "tsx scripts/generate-owner-access.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^8.21.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
