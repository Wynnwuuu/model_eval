# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase backend toggle (must be prefixed with VITE_ to be exposed to the client).
# - unset: use real Firebase when built with `vite build` (import.meta.env.PROD), local mock DB with `vite dev`
# - true: always use Firebase Auth + Firestore (even in dev), if VITE_FIREBASE_* are set
# - false: always use localStorage-backed localPlatform (even for production bundles), e.g. offline demos
# VITE_USE_FIREBASE=true

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Optional generation backend for dataset batch production.
# If unset, the dataset repository uses the built-in mock adapter.
# VITE_GENERATION_BACKEND_URL=http://localhost:8080

# Local PostgreSQL development database.
# Current frontend persistence is still controlled by VITE_USE_FIREBASE; these
# values are for the upcoming backend API -> PostgreSQL data path.
POSTGRES_DB=eval_studio
POSTGRES_USER=eval_studio
POSTGRES_PASSWORD=eval_studio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eval_studio:eval_studio_dev@localhost:5432/eval_studio

# Local backend API.
API_PORT=8787

# Optional frontend switch for the new backend API.
# Keep disabled until the selected feature APIs have been migrated.
# VITE_USE_API_BACKEND=true
# VITE_API_BASE_URL=http://localhost:8787
