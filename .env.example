# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local PostgreSQL development database.
POSTGRES_DB=eval_studio
POSTGRES_USER=eval_studio
POSTGRES_PASSWORD=eval_studio_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eval_studio:eval_studio_dev@localhost:5432/eval_studio

# Local backend API.
API_PORT=8787
CORS_ORIGIN=http://localhost:3000

# Business data uses HTTP API -> PostgreSQL by default.
# Only set VITE_STORAGE_MODE=local or VITE_USE_API_BACKEND=false for an explicit single-browser demo.
# In production single-container deployment, leave VITE_API_BASE_URL empty so the app uses same-origin /api.
# VITE_STORAGE_MODE=local
# VITE_USE_API_BACKEND=false
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_PROXY_TARGET=http://localhost:8787

# Feishu OAuth authentication. Local development defaults to local auth unless VITE_AUTH_MODE=feishu.
# VITE_AUTH_MODE=feishu
# AUTH_MODE=feishu
# JWT_SECRET=replace-with-a-long-random-secret
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_REDIRECT_URI=http://localhost:3000/feishu-callback

# ManuEval -> VidMuse generation (dev only).
# Aion is read/called directly by the Express backend; never expose these values to Vite.
# ACK dev deployment (same default namespace): http://dev-vidmuse-manager-service:443
# Local development can use the admin gateway: https://dev-vidmuse-admin.sandaii.cn/admin
# AION_MANAGER_BASE_URL=http://dev-vidmuse-manager-service:443
# Optional when model execution uses a different gateway/prefix from config discovery.
# Local: https://dev-vidmuse-manager.sandaii.cn/private/api/v1/model
# ACK: http://dev-vidmuse-manager-service:443/model/api/v1/model
# AION_MODEL_API_BASE_URL=http://dev-vidmuse-manager-service:443/model/api/v1/model
# AION_EXECUTION_TRANSPORT=model_api
# AION_EVAL_USER_ID=123456
#
# Local/dev diagnostic fallback when the machine cannot reach the ClusterIP and no runner JWT is
# available. This calls the existing VidFlow task-worker without Planner and forwards only its
# standard image/video controls. Use an existing dedicated smoke thread; production dev should keep
# model_api so config-declared advanced parameters remain available.
# AION_EXECUTION_TRANSPORT=task_worker
# AION_TASK_WORKER_BASE_URL=https://dev-vidmuse-manager.sandaii.cn/manager
# AION_TASK_WORKER_THREAD_ID=replace-with-dedicated-smoke-thread
# Optional CDN overrides for task-worker result paths.
# AION_TASK_WORKER_IMAGE_BASE_URL=https://vidmuse-dev.sandcdn.com
# AION_TASK_WORKER_VIDEO_BASE_URL=https://vidmuse-dev-video.sandcdn.com
# AION_REQUEST_TIMEOUT_MS=30000
# GENERATION_WORKER_ENABLED=true
# GENERATION_MAX_BATCH_SIZE=500
# GENERATION_IMAGE_CONCURRENCY=4
# GENERATION_VIDEO_CONCURRENCY=2
# GENERATION_POLL_INTERVAL_MS=5000
# GENERATION_LEASE_MS=60000
# GENERATION_TASK_TIMEOUT_MS=1500000
# GENERATION_ASSET_MODE=oss

# Temporary dev fallback when OSS credentials are not available. Public input URLs are passed
# through and provider result URLs are written back directly; local uploads are disabled and
# result links may expire.
# GENERATION_ASSET_MODE=temporary_url

# Stable generation assets and browser direct uploads use a least-privilege dev OSS identity.
# MANUEVAL_PUBLIC_BASE_URL=https://manueval-dev.example.com
# MANUEVAL_OSS_ACCESS_KEY_ID=replace-me
# MANUEVAL_OSS_ACCESS_KEY_SECRET=replace-me
# MANUEVAL_OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
# MANUEVAL_OSS_REGION=oss-cn-hongkong
# MANUEVAL_OSS_BUCKET=replace-me
# MANUEVAL_OSS_PREFIX=manueval-dev
# MANUEVAL_OSS_SIGNED_URL_TTL_SECONDS=86400
# GENERATION_MAX_ASSET_BYTES=2147483647
